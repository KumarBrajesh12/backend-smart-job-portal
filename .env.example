# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-job-portal

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Elasticsearch (for future use)
ELASTICSEARCH_NODE=http://localhost:9200

# CORS & frontend (used in verification email links)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email: gmail (real inbox) OR ethereal (local dev, preview in terminal — no Gmail needed)
SMTP_MODE=gmail
# SMTP_MODE=ethereal

# Gmail — App Password only (NOT your normal password). If test:smtp fails with EAUTH, use ethereal above.
# 1) https://myaccount.google.com/security → 2-Step Verification ON
# 2) https://myaccount.google.com/apppasswords → create new password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your.email@gmail.com
SMTP_FROM_NAME=Smart Job Portal
